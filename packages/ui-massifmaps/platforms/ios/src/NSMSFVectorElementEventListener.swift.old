import MassifMaps

@objc(NSMSFVectorElementEventListener)
@objcMembers
class NSMSFVectorElementEventListener: MSFVectorElementEventListener {
  var runOnMainThread = NSMSFMapView.RUN_ON_MAIN_THREAD
  func onVectorElementClickedThreaded(_ clickInfo: MSFVectorElementClickInfo!) -> Bool {
    return false;
  }
  override func onVectorElementClicked(_ clickInfo: MSFVectorElementClickInfo!) -> Bool {
    if (runOnMainThread) {
      var result = false;
      DispatchQueue.main.sync() {
        result = onVectorElementClickedThreaded(clickInfo)
      }
      return result
    } else {
      return onVectorElementClickedThreaded(clickInfo)
    }
  }
}

